{
  "name": "flock",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "Talk to coding agents through a canvas. Runs on the coding CLIs already on your machine.",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/shared/*.test.ts src/main/*.test.ts",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@babel/parser": "8.1.2",
    "@tailwindcss/vite": "4.3.5",
    "@ttmi/board": "workspace:*",
    "@ttmi/format": "workspace:*",
    "@ttmi/model": "workspace:*",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "lucide-react": "1.52.0",
    "phonon-webgpu": "github:blixt/phonon#36e7e5eff820733be38e9df19ccf58ae891bd45c",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "packageManager": "pnpm@12.4.1",
  "author": {
    "name": "Christian Alfoni"
  },
  "homepage": "https://github.com/christianalfoni/flock",
  "repository": {
    "type": "git",
    "url": "https://github.com/christianalfoni/flock.git"
  }
}
